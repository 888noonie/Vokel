# === VOKEL CONFIG (Co-built with Grok) ===

# Local LLM (OpenAI-compatible) — Jan serve default, or LM Studio on :1234
VOKEL_LLM_URL=http://127.0.0.1:6767/v1/chat/completions
VOKEL_LLM_MODEL=HauhauCS/Gemma-4-E4B-Uncensored-HauhauCS-Aggressive
# Optional: enforce a key. If set, scripts/start-backend.sh passes it to `jan serve`;
# if unset, Jan serves with no auth and Vokel auto-discovers (src/vokel/jan_key.py).
# VOKEL_LLM_API_KEY=

# Legacy names still supported
LM_STUDIO_URL=http://127.0.0.1:6767/v1/chat/completions
LM_STUDIO_MODEL=Gemma-4-E4B-Uncensored-HauhauCS-Aggressive-Q5_K_M

# Memory (local, opt-in)
MEMORY_ENABLED=false
MEMORY_DB_PATH=./vokel_memory.db

# Voice / Audio tuning
DEFAULT_VOICE=af_bella                    # see 28 Kokoro voices
SPEED=1.0
